{
  "name": "drvo-erp",
  "version": "0.0.0-k0",
  "private": true,
  "description": "DRVO ERP non-production K0 foundation scaffold",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.json",
